<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SajianSehat" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main Brand Colors (Adjusted slightly for Dark Mode if needed, but keeping green theme) -->
        <item name="colorPrimary">@color/green_500</item>
        <item name="colorPrimaryVariant">@color/green_700</item>
        <item name="colorOnPrimary">@color/black</item>
        
        <!-- Accent Colors -->
        <item name="colorSecondary">@color/orange_500</item>
        <item name="colorSecondaryVariant">@color/orange_600</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Backgrounds & Surfaces (Darker for night mode) -->
        <item name="android:windowBackground">@color/gray_900</item>
        <item name="colorSurface">@color/gray_800</item>
        
        <!-- Typography Colors (Inverted for dark mode) -->
        <item name="android:textColorPrimary">@color/gray_50</item>
        <item name="android:textColorSecondary">@color/gray_400</item>
    </style>

    <style name="Theme.SajianSehat" parent="Base.Theme.SajianSehat" />
</resources>