<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Rekomendasi Makanan"
            app:titleTextColor="?attr/colorOnSurface" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="72dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Program -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/green_500"
                app:strokeWidth="0dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROGRAM REKOMENDASI"
                        android:textColor="@color/green_50"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tvDurasiProgram"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 BULAN"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="32sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvTanggalProgram"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="05 FEB 2026 - 06 MAR 2026"
                        android:textColor="@color/green_100"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Analisis -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/green_100"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@android:color/white"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ANALISIS NUTRISI AI"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvAnalisisKesehatan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Memuat analisis kesehatan..."
                        android:textColor="@color/green_800"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:maxLines="3"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvSaranNutrisi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Saran nutrisi..."
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp"
                        android:maxLines="3"
                        android:ellipsize="end" />
                        
                    <TextView
                        android:id="@+id/tvShowDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show Detail"
                        android:textColor="@color/green_500"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:paddingTop="12dp"
                        android:layout_gravity="end" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tab Navigasi Minggu & Hari -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWeeks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resep Untuk Anda"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- List Resep -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvResep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />

            <!-- Restaurant Section (BARU) -->
            <LinearLayout
                android:id="@+id/layoutRestaurantSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="REKOMENDASI TEMPAT MAKAN"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvRestaurantHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="di Jakarta Pusat"
                    android:textSize="14sp"
                    android:textColor="@color/gray_600"
                    android:layout_marginBottom="12dp" />

                <!-- No Result Message -->
                <TextView
                    android:id="@+id/tvNoRestaurantResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Rekomendasi Makan Lokasi tersebut tidak ada"
                    android:gravity="center"
                    android:padding="24dp"
                    android:textSize="14sp"
                    android:textColor="@color/gray_600"
                    android:visibility="gone" />

                <!-- Restaurant List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRestaurants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        android:elevation="16dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKembali"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Kembali"
            android:textColor="?attr/colorOnSurface"
            app:strokeColor="@color/gray_400" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimpan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Simpan Rekomendasi"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/green_600" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
