<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llDayContainer"
    android:layout_width="72dp"
    android:layout_height="72dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_circle_outlined"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Tulisan "HARI 1" atau "KAMIS" -->
    <TextView
        android:id="@+id/tvDayName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hari 1"
        android:textColor="@color/gray_500"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textAllCaps="true"/>

    <!-- Tanggal membesar (05) - Hanya muncul saat dipilih -->
    <TextView
        android:id="@+id/tvDateNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="05"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Bulan & Tahun (FEB 2026) - Hanya muncul saat dipilih -->
    <TextView
        android:id="@+id/tvMonthYear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FEB 2026"
        android:textColor="@android:color/white"
        android:textSize="8sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
