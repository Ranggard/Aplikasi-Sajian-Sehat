<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/layout_logged_in"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pencarian Resep"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Mode Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih Mode Input Data"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleModeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@+id/btnModeTerstruktur"
            android:layout_marginBottom="16dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeTerstruktur"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Terstruktur"
                style="?attr/materialButtonOutlinedStyle" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeDeskripsi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Deskripsi"
                style="?attr/materialButtonOutlinedStyle" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Container Mode Terstruktur -->
        <LinearLayout
            android:id="@+id/layoutTerstruktur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section Data Profil Wajib -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data Pribadi (Wajib Diisi) *"
                android:textStyle="bold"
                android:textColor="@color/green_700"
                android:layout_marginBottom="12dp"
                android:textSize="14sp" />

            <!-- Jenis Kelamin -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Jenis Kelamin *"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_marginBottom="12dp">
                <AutoCompleteTextView
                    android:id="@+id/autoCompleteJenisKelamin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Umur -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Umur (tahun) *"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUmurRekomendasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Tinggi Badan -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tinggi Badan (cm) *"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTinggiRekomendasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Berat Badan -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Berat Badan (kg) *"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="16dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBeratRekomendasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Checkbox Simpan ke Profil -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbSimpanKeProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Simpan data ke profil saya"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/green_100"
                android:layout_marginBottom="16dp" />

            <!-- Section Data Kondisi &amp; Preferensi -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kondisi &amp; Preferensi Makanan"
                android:textStyle="bold"
                android:textColor="@color/green_700"
                android:layout_marginBottom="12dp"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Bahan yang dimiliki (Opsional)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBahan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Alergi Makanan (Opsional)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAlergi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Kondisi Medis (Opsional)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etKesehatan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Pilih Tipe Diet"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_marginBottom="16dp">
                <AutoCompleteTextView
                    android:id="@+id/autoCompleteDiet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Container Mode Deskripsi -->
        <LinearLayout
            android:id="@+id/layoutDeskripsi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ceritakan kondisi Anda (Wajib Diisi) *"
                android:textStyle="bold"
                android:textColor="@color/green_700"
                android:layout_marginBottom="8dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contoh: Saya mahasiswa laki-laki berusia 22 tahun, tinggi 170 cm, berat 65 kg. Saya vegetarian dan alergi terhadap kacang-kacangan. Saya punya bahan telur, nasi, sayuran hijau. Saya ingin menu yang bergizi dan membantu menurunkan berat badan."
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="italic"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ceritakan kondisi, bahan, dan keinginan Anda *"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="16dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDeskripsiBebas"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:lines="6" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/dividerHorizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- Location Section (BARU) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lokasi (Opsional)"
            android:textStyle="bold"
            android:textColor="@color/green_700"
            android:layout_marginBottom="12dp"
            android:textSize="14sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Lokasi Saat Ini"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:drawableEnd="@drawable/ic_location_on_24"
                android:drawablePadding="8dp"
                android:focusable="false"
                android:clickable="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetLocation"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📍 Gunakan Lokasi Saat Ini"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbExcludeLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jangan kirim lokasi"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/dividerHorizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipe Masakan"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />
        <RadioGroup
            android:id="@+id/rgTipeMasakan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <RadioButton
                android:id="@+id/rbNasional"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Indonesia" />
            <RadioButton
                android:id="@+id/rbInternasional"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Internasional" />
            <RadioButton
                android:id="@+id/rbMix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mix"
                android:checked="true" />
        </RadioGroup>

        <!-- Durasi dipindah ke bawah -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Durasi Rencana Makan"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />
        <RadioGroup
            android:id="@+id/rgDurasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <RadioButton
                android:id="@+id/rb1Hari"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 Hari"
                android:checked="true" />
            <RadioButton
                android:id="@+id/rb1Minggu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 Minggu" />
            <RadioButton
                android:id="@+id/rb1Bulan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 Bulan" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCariRekomendasi"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Analisis &amp; Cari Resep"
            android:textSize="18sp"
            app:cornerRadius="30dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:id="@+id/layoutLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:layout_marginBottom="8dp"/>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI sedang menganalisis..."
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBatalkan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Batalkan"
                style="?attr/materialButtonOutlinedStyle"
                android:textColor="?attr/colorError"
                app:strokeColor="?attr/colorError" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

<!-- Lock Overlay when not logged in -->
<LinearLayout
    android:id="@+id/layout_locked_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/white"
    android:visibility="gone"
    android:padding="24dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_lock"
        android:contentDescription="Lock icon"
        android:tint="@color/green_600"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Menu Terkunci"
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Silakan login terlebih dahulu untuk mengakses fitur pencarian resep"
        android:textAppearance="?attr/textAppearanceBody1"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLoginSekarang"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Login Sekarang"
        app:cornerRadius="24dp" />

</LinearLayout>

</FrameLayout>