<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/gray_100"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- FrameLayout membungkus Image dan Overlay Label -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="180dp">

                <ImageView
                    android:id="@+id/imgResep"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#E0E0E0" />

                <!-- Label Waktu Makan (Sarapan, dll) melayang di gambar -->
                <TextView
                    android:id="@+id/tvWaktuMakan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_rounded_black"
                    android:backgroundTint="@android:color/white"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="SARAPAN"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:elevation="2dp"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvSumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_green"
                    android:backgroundTint="@color/green_100"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="Internasional"
                    android:textColor="@color/green_700"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvJudulResep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Judul Resep"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNutrisi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Kalori: 300 kcal • Protein: 15g"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/dividerHorizontal"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Expandable Toggle Button -->
                <LinearLayout
                    android:id="@+id/layoutToggleDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvToggleText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Lihat Resep &amp; Bahan"
                        android:textColor="@color/green_600"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvToggleIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:textColor="@color/green_600"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Expanded Content (Bahan & Langkah) -->
                <LinearLayout
                    android:id="@+id/layoutExpandedContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bahan-bahan"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvBahan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="- Bahan 1\n- Bahan 2"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cara Memasak"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvCaraMasak"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Langkah 1\n2. Langkah 2"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTutorialVideo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tutorial Video di YouTube"
                        app:iconTint="@android:color/white"
                        style="?attr/materialButtonOutlinedStyle"
                        app:strokeColor="@color/orange_500"
                        android:textColor="@color/orange_600" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
