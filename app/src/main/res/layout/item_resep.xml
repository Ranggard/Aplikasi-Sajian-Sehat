<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="@dimen/elevation_card"
        app:strokeColor="@color/gray_100"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- FrameLayout membungkus Image dan Overlay Label -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="180dp">

                <ImageView
                    android:id="@+id/imgResep"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@color/gray_100"
                    android:src="@drawable/placeholder_recipe"
                    android:contentDescription="@string/empty_recipe_title" />

                <!-- Label Waktu Makan (Sarapan, dll) melayang di gambar -->
                <TextView
                    android:id="@+id/tvWaktuMakan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:background="@drawable/bg_rounded_black"
                    android:backgroundTint="@android:color/white"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="6dp"
                    android:text="SARAPAN"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_xs"
                    android:textStyle="bold"
                    android:elevation="@dimen/elevation_card"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/tvSumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_green"
                    android:backgroundTint="@color/green_100"
                    android:paddingHorizontal="@dimen/spacing_sm"
                    android:paddingVertical="@dimen/spacing_xs"
                    android:text="Internasional"
                    android:textColor="@color/green_700"
                    android:textSize="@dimen/text_sm"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="📍 Jakarta, Pusat"
                    android:textColor="@color/gray_600"
                    android:textSize="@dimen/text_sm"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvJudulResep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="Judul Resep"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="@dimen/text_xl"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvNutrisi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Kalori: 300 kcal • Protein: 15g"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="@dimen/text_md" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/dividerHorizontal"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:layout_marginBottom="@dimen/spacing_md"/>

                <!-- Expandable Toggle Button -->
                <LinearLayout
                    android:id="@+id/layoutToggleDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="@dimen/spacing_sm">

                    <TextView
                        android:id="@+id/tvToggleText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Lihat Resep &amp; Bahan"
                        android:textColor="@color/green_600"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_md" />

                    <TextView
                        android:id="@+id/tvToggleIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:textColor="@color/green_600"
                        android:textSize="@dimen/text_md" />
                </LinearLayout>

                <!-- Expanded Content (Bahan & Langkah) -->
                <LinearLayout
                    android:id="@+id/layoutExpandedContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bahan-bahan"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_md"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:layout_marginBottom="@dimen/spacing_xs"/>

                    <TextView
                        android:id="@+id/tvBahan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="- Bahan 1\n- Bahan 2"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_md"
                        android:lineSpacingExtra="@dimen/spacing_xs"
                        android:layout_marginBottom="@dimen/spacing_md"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cara Memasak"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvCaraMasak"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Langkah 1\n2. Langkah 2"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTutorialVideo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tutorial Video di YouTube"
                        app:iconTint="@android:color/white"
                        style="?attr/materialButtonOutlinedStyle"
                        app:strokeColor="@color/orange_500"
                        android:textColor="@color/orange_600" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/dividerHorizontal"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:layout_marginBottom="@dimen/spacing_md"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rekomendasi Tempat Makan"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_md"
                        android:layout_marginBottom="@dimen/spacing_md"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvRestaurantsInResep"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
