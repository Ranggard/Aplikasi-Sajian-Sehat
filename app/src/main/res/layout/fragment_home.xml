<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sajian Sehat"
            android:textAppearance="?attr/textAppearanceHeadline3"
            android:textColor="@color/green_700"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Solusi Makanan Sehat Masa Kini"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="@dimen/spacing_xl" />

        <!-- Feature Card 1 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="@dimen/elevation_card"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/green_50"
            android:layout_marginBottom="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌟 Personalisasi AI Cerdas"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold"
                    android:textColor="@color/green_900"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dapatkan rekomendasi makanan harian hingga bulanan yang disesuaikan secara spesifik dengan preferensi diet, ketersediaan bahan, dan riwayat kesehatan Anda."
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="@color/green_800"
                    android:lineSpacingExtra="@dimen/spacing_xs"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Feature Card 2 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="@dimen/elevation_card"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/green_50"
            android:layout_marginBottom="@dimen/spacing_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏥 Integrasi Medis &amp; Diet"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold"
                    android:textColor="@color/green_900"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sistem AI kami akan mengecualikan bahan berbahaya dan hanya merekomendasikan resep yang aman sesuai dengan alergi maupun pantangan penyakit kronis yang Anda masukkan."
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="@color/green_800"
                    android:lineSpacingExtra="@dimen/spacing_xs"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMulaiCariResep"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_large"
            android:text="Mulai Cari Resep Sekarang"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold"
            app:cornerRadius="@dimen/button_radius_pill"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"/>

    </LinearLayout>
</ScrollView>
