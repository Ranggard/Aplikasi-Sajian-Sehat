<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_restaurant_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restaurant Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tv_restaurant_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏪 Warung Sunda"
            android:textSize="13sp"
            android:layout_marginBottom="4dp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tv_restaurant_specialty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🍽️ Menu: Ayam Goreng, Nasi Kuning"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tv_restaurant_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tv_restaurant_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Address"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_restaurant_rating"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⭐ 4.5 (100 review)"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tv_restaurant_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💰 Rp 50k-150k"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_map"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Buka di Maps"
            android:textSize="12sp"
            style="?attr/materialButtonOutlinedStyle"
            app:cornerRadius="20dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
